# === Backend (Spring Boot) ===
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL — banco dedicado à aplicação (o Flyway cria as tabelas na primeira inicialização)
DATABASE_URL=jdbc:postgresql://<HOST>:5432/castro
DATABASE_USER=castro
DATABASE_PASSWORD=SUA_SENHA

# JWT — gere com: openssl rand -base64 48
JWT_SECRET=TROQUE_POR_UMA_CHAVE_FORTE_COM_PELO_MENOS_32_CARACTERES
JWT_EXPIRATION=86400000
