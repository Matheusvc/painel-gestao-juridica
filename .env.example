# === Backend (Spring Boot) ===
SPRING_PROFILES_ACTIVE=prod

# Supabase PostgreSQL — pegue em: Supabase > Settings > Database > Connection string (JDBC)
DATABASE_URL=jdbc:postgresql://db.<PROJECT_REF>.supabase.co:5432/postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=SUA_SENHA_SUPABASE

# JWT — gere com: openssl rand -base64 48
JWT_SECRET=TROQUE_POR_UMA_CHAVE_FORTE_COM_PELO_MENOS_32_CARACTERES
JWT_EXPIRATION=86400000

# CORS — URL do frontend em producao (sem barra no final)
CORS_ORIGINS=https://seu-dominio.vercel.app

# === Frontend (Vite) ===
# URL do backend em producao
VITE_API_URL=https://seu-backend.railway.app/api
